# ── BuildTrack — environment variables ───────────────────────────────────────
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (Production + Preview).

# Postgres (Neon). The Vercel Neon integration also provides POSTGRES_URL.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# JWT signing secret — use 32+ random characters
JWT_SECRET="change-me-to-a-long-random-string"

# Optional token lifetimes (defaults shown)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# Vercel Blob (added automatically by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=""

# Frontend API base URL.
#   local:  http://localhost:5069   (the `npm run dev:api` server)
#   Vercel: leave EMPTY so the app calls the same-origin /api
VITE_API_BASE_URL="http://localhost:5069"

# Local dev API port (optional, defaults to 5069)
API_PORT=5069
