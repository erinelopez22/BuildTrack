# Copy this to appsettings.Development.json or set as environment variables

# Database
ConnectionStrings__DefaultConnection="Server=localhost\SQLEXPRESS;Database=BuildTrackDB;Trusted_Connection=True;TrustServerCertificate=True"

# JWT - generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
Jwt__Secret="your-super-secret-jwt-key-at-least-32-characters-long"
Jwt__Issuer="BuildTrack.API"
Jwt__Audience="BuildTrack.Frontend"
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=30

# CORS
Cors__AllowedOrigins__0="http://localhost:8080"
Cors__AllowedOrigins__1="http://localhost:5173"

# Email (optional - for notifications)
Email__SmtpHost="smtp.gmail.com"
Email__SmtpPort=587
Email__SenderEmail="your-email@gmail.com"
Email__SenderPassword="your-app-password"
Email__SenderName="BuildTrack"
