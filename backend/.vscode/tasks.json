{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BuildTrack.API/BuildTrack.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/BuildTrack.API/BuildTrack.API.csproj"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "ef-migration",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef",
        "migrations",
        "add",
        "InitialCreate",
        "--output-dir",
        "Data/Migrations",
        "--project",
        "${workspaceFolder}/BuildTrack.API/BuildTrack.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ef-update",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef",
        "database",
        "update",
        "--project",
        "${workspaceFolder}/BuildTrack.API/BuildTrack.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
